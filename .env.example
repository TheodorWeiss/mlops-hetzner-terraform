# =========================
# BikeML MLOps stack example
# Copy this file to .env and replace values.
# Do NOT commit .env to Git.
# =========================

# Project
COMPOSE_PROJECT_NAME=bikeml
TZ=Europe/Berlin

# Paths on MLOps server
MLOPS_DATA_ROOT=/mnt/mlops-data
POSTGRES_DATA_DIR=/mnt/mlops-data/postgres
MINIO_DATA_DIR=/mnt/mlops-data/minio
AIRFLOW_DATA_DIR=/mnt/mlops-data/airflow
MLFLOW_DATA_DIR=/mnt/mlops-data/mlflow
FEAST_DATA_DIR=/mnt/mlops-data/feast
INCOMING_RAW_DIR=/mnt/mlops-data/incoming-raw
PROCESSED_DATA_DIR=/mnt/mlops-data/processed-data

# PostgreSQL
POSTGRES_USER=bikeml_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=postgres

AIRFLOW_DB=airflow
MLFLOW_DB=mlflow
BIKEML_DB=bikeml

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001

MINIO_BUCKET_RAW=bikeml-raw
MINIO_BUCKET_PROCESSED=bikeml-processed
MINIO_BUCKET_MODELS=bikeml-models
MINIO_BUCKET_REPORTS=bikeml-reports

# MLflow
MLFLOW_PORT=5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_PASSWORD
MLFLOW_ARTIFACT_BUCKET=bikeml-models

# Airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_PORT=8080

# Redis
REDIS_PORT=6379

# Later: Persistent Raw Ingestion Server
INGESTION_SSH_HOST=CHANGE_ME
INGESTION_SSH_USER=CHANGE_ME
INGESTION_RAW_PATH=/srv/bikeml/raw/gbfs
